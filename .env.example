# Docker reaches the host through this alias. For native runs use 127.0.0.1.
IB_HOST=host.docker.internal
# 7497 = TWS paper; 7496 = live TWS for market DATA ONLY. Gateway ports differ;
# configure its API port to 7497/7496, or use TWS.
IB_PORT=7497
IB_CLIENT_ID=71
DATA_DIR=./data
POLL_SECONDS=20
QUOTE_TIMEOUT_SECONDS=12
MAX_QUOTE_AGE_SECONDS=30
MAX_SPREAD_POINTS=2
STRIKE_SCAN_COUNT=16
EVALUATION_SESSIONS=14
# Automatically reconcile from IBKR's historical SPX close, labeled as a
# closing-index PROXY rather than verified official SPXW exercise settlement.
AUTO_SETTLE_FROM_IB_CLOSE=true
SETTLEMENT_DELAY_MINUTES=15

# Optional. Off by default. Enabling sends market context (not account data)
# to the explicitly configured provider. No LLM is used for trade decisions.
ADVISOR_ENABLED=false
ADVISOR_PROVIDER=ollama
ADVISOR_BASE_URL=http://127.0.0.1:11434
ADVISOR_MODEL=llama3.2
ADVISOR_API_KEY=
# OpenAI: provider=openai, base_url=https://api.openai.com, model=gpt-4o-mini
# Anthropic: provider=anthropic, base_url=https://api.anthropic.com,
# model=claude-sonnet-4-5
